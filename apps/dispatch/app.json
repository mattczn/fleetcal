{
  "expo": {
    "name": "FleetCal Go",
    "slug": "dispatchgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "fleetcal-go",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a73e8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.systematica.fleetcal.dispatch",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "192.168.7.126": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "FleetCal Go records where you clock in and out so your timesheet shows which yard or shop you worked at.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "While you are clocked in, FleetCal Go records your location about every 10 minutes so your supervisor can see which yard or shop you are working at. Location is recorded only between clock in and clock out, never when you are off the clock."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A56DB"
      },
      "package": "com.systematica.fleetcal.dispatch",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/stripAppleSignIn.js",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FleetCal Go to access your photos so you can attach paperwork to loads.",
          "cameraPermission": "Allow FleetCal Go to use your camera to capture paperwork."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow FleetCal Go to scan paperwork documents."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "While you are clocked in, FleetCal Go records your location about every 10 minutes so your supervisor can see which yard or shop you are working at.",
          "locationWhenInUsePermission": "FleetCal Go records where you clock in and out so your timesheet shows which yard or shop you worked at.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "clerkPublishableKey": "pk_live_Y2xlcmsuZmxlZXRjYWwuYXBwJA",
      "supabaseUrl": "https://vgybqmvmorjhlgbsssmi.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZneWJxbXZtb3JqaGxnYnNzc21pIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY5MDA4MzcsImV4cCI6MjA5MjQ3NjgzN30.c6IutFuTbGiuCUSYXO0bVh-Wa_K00dq9Wc8jgiIEYuE",
      "googleMapsKey": "AIzaSyDKxh_Na3r3bjA9LgZTgQ7JRJ-X-BvoYfo",
      "dispatchApiUrl": "https://www.fleetcal.app",
      "railwayApiUrl": "https://fleetcalapi-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "eb0ae55b-8fee-47e1-85e7-473eaba4d811"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
