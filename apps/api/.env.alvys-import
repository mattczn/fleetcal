# Alvys import — env vars for src/scripts/import-alvys-loads.ts
# Copy this to .env then fill in the values. The script auto-loads .env
# via dotenv. Never commit real values.

# ── FleetCal Supabase ───────────────────────────────────────────────
# This is the FleetCal project (the one your API server already uses).
SUPABASE_URL=https://vgybqmvmorjhlgbsssmi.supabase.co
# Get from: Supabase dashboard → vgybqmvmorjhlgbsssmi project → Settings
#   → API → "service_role" secret. Click the eye icon to reveal, then copy.
SUPABASE_SERVICE_ROLE_KEY=

# ── Alvys API ───────────────────────────────────────────────────────
# Same creds as your my-calendar setup. If you have them already in
# my-calendar's env or Railway dashboard, copy them here verbatim.
ALVYS_CLIENT_ID=
ALVYS_CLIENT_SECRET=

# ── my-calendar Supabase (for stage 2 — miles enrichment) ───────────
# This is the OTHER Supabase project where my-calendar stores its data.
MYCAL_SUPABASE_URL=https://vgglyebsbbgooqmguzmi.supabase.co
# Get from: Supabase dashboard → vgglyebsbbgooqmguzmi project → Settings
#   → API → "service_role" secret.
MYCAL_SUPABASE_SERVICE_KEY=
