# Copy to .env.local and fill in. Never commit real values.

# HTTP server
PORT=8080
NODE_ENV=development

# Clerk — backend SDK uses the secret key to verify session tokens.
# Get these from https://dashboard.clerk.com/ → API Keys.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Supabase — service role key, NOT the anon key. The API server is the
# only thing that should hold this. Get it from
# https://app.supabase.com/project/vgybqmvmorjhlgbsssmi/settings/api
SUPABASE_URL=https://vgybqmvmorjhlgbsssmi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Note: driver-app auth tokens are verified against Supabase's JWKS
# endpoint (modern asymmetric signing) — no shared secret needed.

# Telegram bot integration — optional. Leave blank to disable /v1/bot/* routes.
# BOT_API_KEY: generate with: openssl rand -hex 32
# BOT_ORG_ID:  your Clerk org ID (find it in Clerk dashboard → Organizations,
#              or from any JWT payload's org_id claim, or /v1/whoami in the app)
BOT_API_KEY=
BOT_ORG_ID=

# Resend — outbound email for the accounting module (invoice sends,
# batch-send to brokers). When RESEND_API_KEY is unset, the /:id/send
# and /batch-send endpoints return 503 with "email not configured" so
# the rest of the API works fine in local dev without Resend.
#
# Setup:
#   1. Sign in at https://resend.com → API Keys → Create API Key
#      (full-access or sending-only is fine).
#   2. Add and verify a sending domain at
#      https://resend.com/domains. Until verified you can only send
#      FROM resend.dev for testing.
#   3. Set INVOICE_FROM_EMAIL to an address on the verified domain
#      (e.g. invoices@yourcompany.com). The display name is the
#      carrier's company from their invoice settings; this is the
#      envelope address.
#   4. INVOICE_FROM_NAME is the fallback display name when an org
#      hasn't set their company name yet.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=invoices@fleetcal.app
INVOICE_FROM_NAME=FleetCal Invoicing

# Mapbox access token for server-side route geometry (events.route_polyline
# compute-on-read in lib/routeGeometry.ts). Same token the web app uses as
# NEXT_PUBLIC_MAPBOX_TOKEN. Optional — when unset, the detail endpoints skip
# polyline caching and map clients fall back to their own route draw.
MAPBOX_TOKEN=

# INTERNAL sales CRM (routes/crm.ts). Comma-separated Clerk org ids
# allowed to use it — unset disables the CRM entirely (routes 404, sync
# cron no-ops). Customer-facing deploys leave this blank.
CRM_INTERNAL_ORG_IDS=
# Optional Socrata app token for the FMCSA census pulls (higher rate
# limits). Register at data.transportation.gov → Developer Settings.
FMCSA_SODA_APP_TOKEN=

# Truck History module (Curzon-only): equipment history + post-trip
# inspections + inspection-sourced maintenance reports. Comma-separated
# Clerk org ids. Unset = module disabled everywhere (routes 404, driver
# org-settings flag false).
TRUCK_HISTORY_ORG_IDS=

# CRM outreach sending identity — MUST be the dedicated outreach domain
# (fleetcalendar.app), never fleetcal.app, so cold-email reputation
# can't touch invoice deliverability. Domain must be verified in Resend.
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=
OUTREACH_REPLY_TO=
# Svix signing secret from the Resend webhook pointing at
# /v1/crm-public/resend-webhook (bounce/complaint suppression).
RESEND_WEBHOOK_SECRET=
# Public API base URL for building unsubscribe links.
PUBLIC_API_URL=https://fleetcalapi-production.up.railway.app

# Email verification (NeverBounce). Enroll refuses and the send sweep
# defers materialization until a lead's email has verdict='valid', so a
# stale FMCSA address never lands on a fresh domain as a hard bounce.
# API key format: secret_XXXX from app.neverbounce.com → API.
EMAIL_VERIFIER_PROVIDER=never_bounce
NEVERBOUNCE_API_KEY=
