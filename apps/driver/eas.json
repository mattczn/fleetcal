{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios":     { "simulator": true },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios":     { "simulator": false },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel":       "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId":     "TODO_SYSTEMATICA_APPLE_ID",
        "ascAppId":    "TODO_FLEETCAL_DRIVER_ASC_APP_ID",
        "appleTeamId": "TODO_SYSTEMATICA_TEAM_ID"
      }
    }
  }
}
